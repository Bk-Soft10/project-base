<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_us_messenger_partner_form" model="ir.ui.view">
        <field name="name">us.messenger.partner.form</field>
        <field name="model">us.messenger.partner</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="bot_id" readonly="1"/>
                        <field name="external_id" readonly="1"/>
                        <field name="name" readonly="1"/>
                    </group>
                    <group>
                        <field name="channel_id" readonly="1"/>
                        <field name="channel_create_date" readonly="1"/>
                        <field name="message_count" readonly="1"/>
                        <field name="messenger_operator_id" readonly="1"/>
                        <field name="username" readonly="1"/>
                        <field name="script_id" invisible="1"/>
                        <field name="current_step_id" domain="[('script_id', '=', script_id)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
