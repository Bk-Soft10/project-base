<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="messenger_job_view_list" model="ir.ui.view">
        <field name="name">us.messenger.job.list</field>
        <field name="model">us.messenger.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="function"/>
                <field name="state"/>
                <field name="project_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="messenger_job_view_form" model="ir.ui.view">
        <field name="name">us.messenger.job.form</field>
        <field name="model">us.messenger.job</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="function" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" />
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Logs">
                        <field
                            name="log_ids"
                            nolabel="1"
                            readonly="1"
                            editable="bottom"
                            colspan="2"
                        >
                            <list
                                decoration-muted="level == 'debug'"
                                decoration-danger="level in ['error', 'critical']"
                                decoration-warning="level == 'warning'"
                                default_order="id"
                            >
                                <field name="id" />
                                <field name="create_date" />
                                <field name="level" />
                                <field name="name" />
                                <field name="message_short" />
                            </list>
                            <form>
                                <field name="message" />
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="messenger_job_view_search" model="ir.ui.view">
        <field name="name">us.messenger.job.search</field>
        <field name="model">us.messenger.job</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Started jobs"
                    name="started_jobs"
                    domain="[('state', '=', 'started')]"
                />
                <filter
                    string="Done jobs"
                    name="done_jobs"
                    domain="[('state', '=', 'done')]"
                />
                <filter
                    string="Failed jobs"
                    name="failed_jobs"
                    domain="[('state', '=', 'failed')]"
                />
            </search>
        </field>
    </record>
    <record id="messenger_job_action_from_project" model="ir.actions.act_window">
        <field name="name">Project Jobs</field>
        <field name="res_model">us.messenger.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field name="search_view_id" ref="messenger_job_view_search" />
    </record>

    <record id="messenger_job_action" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">us.messenger.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="messenger_job_view_search" />
    </record>
</odoo>
