<?xml version="1.0" encoding="UTF-8" ?>
<odoo><data>

    <record id="messenger_script_view_form" model="ir.ui.view">
        <field name="name">us.messenger.script.view.form</field>
        <field name="model">us.messenger.script</field>
        <field name="arch" type="xml">
            <form>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. My Script"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="bot_type" readonly="id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Script Steps" name="script_steps">
                            <field name="available_question_selection" invisible="1"/>    
                            <field name="script_step_ids" widget="messenger_script_steps_one2many">
                                <list default_order="sequence asc">
                                    <field name="sequence" widget="handle"/>
                                    <field name="message" width="350px"/>
                                    <field name="step_type_id"/>          
                                    <field name="step_command" invisible="not step_command" optional="show"/>          
                                    <field name="answer_ids" column_invisible="not parent.available_question_selection" widget="messenger_triggering_answers_widget"/>
                                    <field name="next_step_id" domain="[('script_id', '=', script_id), ('id', '!=', id)]"/>
                                </list>
                            </field>
                        </page>
                        <page string="Common Answers" name="common_answers">
                            <group>
                                <group>
                                    <field name="share_phone_btn_text"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
            </form>
        </field>
    </record>

    <record id="messenger_script_view_tree" model="ir.ui.view">
        <field name="name">us.messenger.script.view.list</field>
        <field name="model">us.messenger.script</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bot_type"/>
            </list>
        </field>
    </record>

    <record id="messenger_script_action" model="ir.actions.act_window">
        <field name="name">Scripts</field>
        <field name="res_model">us.messenger.script</field>
        <field name="view_mode">list,form</field>
    </record>
    
</data></odoo>