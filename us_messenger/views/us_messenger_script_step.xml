<?xml version="1.0" encoding="UTF-8" ?>
<odoo><data>

    <record id="messenger_script_step_view_form" model="ir.ui.view">
        <field name="name">us.messenger.script.step.view.form</field>
        <field name="model">us.messenger.script.step</field>
        <field name="arch" type="xml">
            <form disable_autofocus="1">
                <sheet>
                    <group>
                        <group>
                            <field name="step_type_id" options="{'no_open': True, 'no_create': True}" domain="[('bot_type','in',['all_bots', bot_type])]"/>
                            <field name="message" placeholder="e.g. 'How can I help you?'"/>
                            <field name="show_success_message" invisible="1"/>
                            <field name="show_fault_message" invisible="1"/>
                            <field name="step_type_code" invisible="1"/>
                            <field name="apply_for_partner" invisible="step_type_code not in ['question_email', 'question_phone']"/>
                            <field name="success_message" placeholder="e.g. 'Thanks, your response has been saved." invisible="not show_success_message"/>
                            <field name="fault_message" placeholder="e.g. 'Error processing message, incorrect data entered.'" required="show_fault_message" invisible="not show_fault_message"/>
                            <field name="script_id" invisible="1"/>
                            <field name="available_question_selection" invisible="1"/>
                            <field name="step_command"/>
                            <field name="next_step_id" domain="[('script_id', '=', script_id), ('id', '!=', id)]"/>
                            <field name="is_manual_next_step" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="answer_ids" invisible="'question_selection' not in step_type_code" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_name" column_invisible="True"/>
                                    <field name="name"/>
                                    <field name="next_step_id" domain="[('script_id', '=', script_id)]"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="messenger_script_step_view_tree" model="ir.ui.view">
        <field name="name">us.messenger.script.step.view.list</field>
        <field name="model">us.messenger.script.step</field>
        <field name="arch" type="xml">
            <list default_order="sequence asc">
                <field name="sequence" widget="handle"/>
                <field name="message"/>
                <field name="step_type_id"/>
            </list>
        </field>
    </record>

</data></odoo>
