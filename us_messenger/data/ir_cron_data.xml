<odoo>
    <data noupdate="1">
        <record id="ir_cron_cleanup_messenger_jobs" model="ir.cron">
            <field name="name">Messenger: Cleanup Old Jobs</field>
            <field name="model_id" ref="model_us_messenger_job"/>
            <field name="state">code</field>
            <field name="code">model._gc_messenger_jobs()</field>
            <field name="interval_number">2</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>