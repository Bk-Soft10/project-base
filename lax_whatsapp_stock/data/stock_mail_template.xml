<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Email Template for Stock Picking Details -->
        <record id="stock_picking_email_template" model="mail.template">
            <field name="name">Stock Picking Details</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="subject">Stock Picking Details for Picking Number: {{ object.name or 'N/A' }}</field>
            <field name="email_from">{{ object.company_id.email or 'support@company.com' }}</field>
            <field name="email_to">{{ object.partner_id.email or 'support@company.com' }}</field>
            <field name="body_html">
                <![CDATA[
                <div style="font-family: Arial, sans-serif; margin: 0; padding: 0;">
                    <p style="font-size: 14px; color: #333;">
                        Dear *<t t-esc="object.partner_id.name or 'Customer'"/>*,
                        <br/><br/>
                        Please find below the details of your stock picking:
                        <br/><br/>
                        *Picking Number:* <t t-esc="object.name or 'N/A'"/><br/>
                        *Picking Type:* <t t-esc="object.picking_type_id.name or 'N/A'"/><br/>
                        *Source Location:* <t t-esc="object.location_id.name or 'N/A'"/><br/>
                        *Destination Location:* <t t-esc="object.location_dest_id.name or 'N/A'"/><br/>
                        *Date:* <t t-esc="object.scheduled_date or 'N/A'"/><br/>
                        <br/>
                        If you have any questions or need further assistance, please do not hesitate to contact us.
                        <br/><br/>
                        Best regards,
                        <br/>
                        *<t t-esc="object.company_id.name"/>*
                    </p>
                </div>
                ]]>
            </field>
            <field name="lang">{{ object.company_id.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
