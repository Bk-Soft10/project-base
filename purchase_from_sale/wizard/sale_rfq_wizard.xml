<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_document_validate_wizard_form" model="ir.ui.view">
        <field name="name">ai.document.validate.wizard.form</field>
        <field name="model">ai.document.validate.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Document Validate Wizard">
                <field name="id" force_save="1" invisible="1"/>
                <field name="can_update_select" force_save="1" invisible="1"/>
                <field name="res_model" force_save="1" invisible="1"/>
                <field name="ai_action_ids" force_save="1" invisible="1"/>
                <group colspan="4">
                    <field name="attachment_id" force_save="1" required="1" readonly="1" options="{'no_create': 1, 'no_open': 1}"/>
                </group>
                <notebook>
                    <page name="wizard_info_pg" string="Information" invisible="not attachment_id or not ai_type_id">
                        <group>
                            <group>
                                <field name="ai_type_id" force_save="1" options="{'no_create': 1, 'no_open': 1}"
                                       required="1" readonly="1"/>
                            </group>
                            <group>
                                <field name="ai_action_id" force_save="1" options="{'no_create': 1, 'no_open': 1}"
                                       domain="[('id', 'in', ai_action_ids), ('action_level', 'in', ['document', False]), ('model_id.model', '=', res_model)]"
                                       invisible="not attachment_id or not ai_type_id or not ai_data_result"/>
                            </group>
                        </group>
                    </page>
                    <page name="wizard_data_pg" string="AI Data" invisible="not ai_data_ids">
                        <group colspan="4">
                            <field name="ai_data_ids" force_save="1" nolabel="1" colspan="2" context="{'view_mode': 'list'}"
                                   readonly="not ai_action_ids" domain="[('type', 'not in', ['object'])]" />
                        </group>
                    </page>
                    <page name="wizard_result_pg" string="AI Data Result" invisible="not ai_data_result">
                        <group colspan="4" invisible="not ai_data_result">
                            <field name="ai_data_result" force_save="1" readonly="1" widget="web_json_viewer"/>
                        </group>
                    </page>
                </notebook>
                <footer>
                    <button name="action_validate" type="object" string="Update" class="oe_highlight"
                            invisible="not ai_data_ids or (not ai_action_id and not can_update_select)"/>
                    <button string="Cancel" class="btn-secondary" type="object" name="action_close"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_ai_document_validate_wizard_open">
        <field name="name">AI Document Validate Wizard</field>
        <field name="res_model">ai.document.validate.wizard</field>
        <field name="view_id" ref="view_ai_document_validate_wizard_form"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="view_mode">form</field>
        <field name="context">{'default_attachment_id': active_id}</field>
        <field name="target">new</field>
    </record>
</odoo>