<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_rfq_wizard_form" model="ir.ui.view">
        <field name="name">sale.rfq.wizard.form</field>
        <field name="model">sale.rfq.wizard</field>
        <field name="arch" type="xml">
            <form string="Sale RFQ Wizard">
                <field name="id" force_save="1" invisible="1"/>
                <group colspan="4">
                    <field name="sale_id" force_save="1" required="1" readonly="1" options="{'no_create': 1, 'no_open': 1}"/>
                </group>
                <group>
                    <group>
                        <field name="warehouse_id" force_save="1" options="{'no_create': 1, 'no_open': 1}"
                               required="1" readonly="1"/>
                        <field name="picking_type_id" force_save="1" options="{'no_create': 1, 'no_open': 1}"
                               required="1"/>
                    </group>
                    <group>
                        <field name="user_id" force_save="1" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="company_id" force_save="1" options="{'no_create': 1, 'no_open': 1}"/>
                    </group>
                </group>
                <notebook>
                    <page name="wizard_line_pg" string="Order Lines" invisible="not line_ids">
                        <group colspan="4">
                            <field name="line_ids" force_save="1" nolabel="1" colspan="2"
                                   options="{'no_create': 1, 'no_open': 1}"
                                   context="{'view_mode': 'list', 'create': False, 'edit': False}"/>
                        </group>
                    </page>
                </notebook>
                <footer>
                    <button name="action_submit" type="object" string="Update" class="oe_highlight"
                            invisible="not line_ids or not picking_type_id or not sale_id"/>
                    <button string="Cancel" class="btn-secondary" type="object" name="action_close"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_sale_rfq_wizard_open">
        <field name="name">Sale RFQ Wizard</field>
        <field name="res_model">sale.rfq.wizard</field>
        <field name="view_id" ref="view_sale_rfq_wizard_form"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="view_mode">form</field>
        <field name="context">{'default_sale_id': active_id}</field>
        <field name="target">new</field>
    </record>

</odoo>