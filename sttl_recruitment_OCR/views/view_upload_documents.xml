<odoo>
    <record id="wizard_view_form" model="ir.ui.view">
        <field name="name">wizard.view.form</field>
        <field name="model">upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Resume Processing OCR" class="oe_form_custom">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="file_name" invisible="0"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="json_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

   <record id="view_wizard_tree_view" model="ir.ui.view">
        <field name="name">view.wizard.list.view</field>
        <field name="model">upload.wizard</field>
        <field name="arch" type="xml">
            <list string="Resume Processing OCR" js_class="button_in_tree">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_extract_data" model="ir.actions.server">
        <field name="name">Extract Application Data</field>
        <field name="model_id" ref="sttl_recruitment_OCR.model_upload_wizard"/>
        <field name="binding_model_id" ref="sttl_recruitment_OCR.model_upload_wizard"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_ocr_resume()</field>
    </record>
    <record id="action_create_application" model="ir.actions.server">
        <field name="name">Create Applications</field>
        <field name="model_id" ref="sttl_recruitment_OCR.model_upload_wizard"/>
        <field name="binding_model_id" ref="sttl_recruitment_OCR.model_upload_wizard"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_save()</field>
    </record>
    <record id="action_upload_wizard_action" model="ir.actions.act_window">
        <field name="name">New Applications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">upload.wizard</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_new_application"
        name="New application"
        sequence="3"
        parent="hr_recruitment.menu_hr_recruitment_root"
        action="action_upload_wizard_action"
    />
</odoo>